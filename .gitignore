# Godot generated cache and Android build template.
.godot/
/android/

# Local temporary files, logs, and crash dumps.
__pycache__/
*.py[cod]
*.tmp
*.temp
*.bak
*.swp
*.swo
*~
*.log
*.dmp
/tmp/
/temp/
/.tmp/
/logs/

# Exported games and build output (keep source assets and import settings).
/build/
/builds/
/dist/
/exports/
*.exe
*.pck
*.pdb
*.msi
*.msix

# Local credentials and private keys. Example environment templates may be shared.
.env
.env.*
!.env.example
!.env.template
/secrets/
/.secrets/
credentials*.json
secrets*.json
*.pem
*.key
*.p12
*.pfx
/export_credentials.cfg

# OS-generated metadata.
.DS_Store
Thumbs.db
desktop.ini

